{
  "name": "fretwise",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive guitar and music theory workbench: circle of fifths, fretboard (scales, chords, triads, CAGED, alternate tunings) and modes.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
